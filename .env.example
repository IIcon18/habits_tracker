# Скопируй в .env и заполни.

# Токен бота от @BotFather — нужен для проверки подписи initData.
BOT_TOKEN=

# HTTPS-адрес Mini App (туннель на фронтенд, напр. https://xxx.trycloudflare.com).
# Бот ставит по нему кнопку меню «Капля» и кнопку «Открыть Каплю» в сообщениях.
WEBAPP_URL=

POSTGRES_USER=kaplya
POSTGRES_PASSWORD=kaplya
POSTGRES_DB=kaplya
# Для запуска API без Docker (из backend/):
DATABASE_URL=postgresql+asyncpg://kaplya:kaplya@localhost:5433/kaplya

# Только для разработки: запросы без initData идут от имени этого пользователя.
DEBUG=0
DEV_USER_ID=
